# ===================================
# HTACCESS ДЛЯ NOVACREATOR STUDIO
# Продакшн-версия: SEO + безопасность + производительность
# ===================================

# Включаем mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Enforce single canonical host and https
    RewriteCond %{HTTP_HOST} !^novacreatorstudio\.com$ [NC,OR]
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://novacreatorstudio.com/$1 [R=301,L]
    
    # ЧПУ - убираем .php расширение
    # Исключаем portfolio и другие файлы, которые могут вызывать циклы редиректов
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteCond %{REQUEST_URI} ^(.+)\.php$
    RewriteCond %{REQUEST_URI} !^/(portfolio|index|contact|about|services|seo|ads|blog|faq|calculator|vacancies)\.php$
    RewriteRule ^(.+)\.php$ /$1 [R=301,L]
    
    # Мультиязычность (должно быть ПЕРЕД правилом добавления .php)
    # Обрабатываем только URL вида /ru/... или /en/...
    # КРИТИЧНО: не применяем, если уже есть параметр lang в query string, чтобы избежать циклов
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{QUERY_STRING} !lang=
    RewriteRule ^(ru|en)/(.*)$ $2?lang=$1 [L]
    
    # Добавляем .php расширение для ЧПУ (включая portfolio)
    # Важно: проверяем, что файл существует, чтобы избежать циклов
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^\.]+)$ $1.php [L]

    # Блокируем прямой доступ к служебным папкам
    RewriteRule ^(?:node_modules|scripts|includes|admin/includes|lang)/ - [F,L,NC]
</IfModule>

# КЕШИРОВАНИЕ БРАУЗЕРА - Улучшенное
<IfModule mod_expires.c>
    ExpiresActive On
    # Изображения
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # CSS и JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    # Шрифты
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    # Другие файлы
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/rss+xml "access plus 1 hour"
    ExpiresByType application/atom+xml "access plus 1 hour"
    ExpiresDefault "access plus 1 month"
</IfModule>

# СЖАТИЕ GZIP - Улучшенное
<IfModule mod_deflate.c>
    # HTML
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    # CSS и JavaScript
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    # JSON и XML
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    # RSS и Atom
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    # SVG
    AddOutputFilterByType DEFLATE image/svg+xml
    # Исключаем уже сжатые файлы
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|rar)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \.(?:mp3|mp4|avi|mov|wmv|flv|swf)$ no-gzip dont-vary
</IfModule>

# СЖАТИЕ BROTLI (если доступно)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# БЕЗОПАСНОСТЬ И ПРОИЗВОДИТЕЛЬНОСТЬ
<IfModule mod_headers.c>
    # Безопасность
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    
    # Производительность - кеширование
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot|css|js)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML/PHP не кешируем агрессивно
    <FilesMatch "\.(php|html?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # HSTS только на HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Корректный Vary для сжатия
    Header append Vary Accept-Encoding
</IfModule>

# ЗАЩИТА ФАЙЛОВ
<FilesMatch "\.(env|config\.php|gitignore|htaccess|db|sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Дополнительно блокируем dotfiles кроме well-known
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# MIME ТИПЫ
<IfModule mod_mime.c>
    AddType application/javascript js
    AddType application/json json
    AddType image/webp webp
    AddType image/svg+xml svg
    AddType image/x-icon ico
    AddDefaultCharset utf-8
</IfModule>

# CUSTOM ERROR PAGES
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# ОТКЛЮЧАЕМ DIRECTORY LISTING
Options -Indexes

# ===================================
# OAUTH КОНФИГУРАЦИЯ (GOOGLE, APPLE)
# ===================================
# Раскомментируйте и заполните значения для автоматической установки OAuth на сервере
# Эти переменные окружения автоматически сохраняются в базу данных при первом запуске
#
# SetEnv GOOGLE_CLIENT_ID "YOUR_GOOGLE_CLIENT_ID_HERE"
# SetEnv GOOGLE_CLIENT_SECRET "YOUR_GOOGLE_CLIENT_SECRET_HERE"
#
# Для Apple OAuth (опционально):
# SetEnv APPLE_CLIENT_ID "YOUR_APPLE_CLIENT_ID_HERE"
# SetEnv APPLE_TEAM_ID "YOUR_APPLE_TEAM_ID_HERE"
# SetEnv APPLE_KEY_ID "YOUR_APPLE_KEY_ID_HERE"
# SetEnv APPLE_PRIVATE_KEY_PATH "/path/to/private_key.p8"
#
# Базовый URL для OAuth (опционально, обычно определяется автоматически):
# SetEnv OAUTH_BASE_URL "https://novacreatorstudio.com"
